server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 32m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Browser calls /api/... on this host. Forward to the backend without /api
    # so FastAPI still sees /auth, /hackathons, /submissions, and the rest.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Keep Set-Cookie on the response. Cookies with no Domain are stored
        # for this frontend host. If the backend names its own host, rewrite
        # that Domain to the host the browser actually called.
        proxy_pass_header Set-Cookie;
        proxy_cookie_domain ${BACKEND_HOST} $host;
        proxy_cookie_path / /;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
